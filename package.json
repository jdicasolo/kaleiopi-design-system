{
  "name": "kaleiopi-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Kaleiopi component library — brand tokens and UI primitives for the Kaleiopi app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "deploy-storybook": "npm run build-storybook && aws s3 sync storybook-static s3://kaleiopi-design-system --delete --cache-control no-cache && aws cloudfront create-invalidation --distribution-id E2KELD0GQ4SQ8P --paths '/*'",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/tokens/theme.css dist/theme.css",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "lucide-react": "^1.48.0"
  }
}
